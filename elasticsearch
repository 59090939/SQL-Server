⬤ 获取ES索引创建时间
#!/bin/bash
ES_URL="http://192.168.12.189:9200"
ES_USER="elastic"
ES_PWD="111111"
echo -e "索引名称\t\t\t创建时间戳(ms)\t可读创建时间"
echo "-------------------------------------------------------------------------"

curl -s -u ${ES_USER}:${ES_PWD} "${ES_URL}/_cat/indices?v&h=index,cd" | \
awk '
NR>1 {
    idx=$1
    cd=$2
    if(cd == "") next
    sec = int(cd / 1000)
    cmd = "date -d @" sec " \"+%Y-%m-%d %H:%M:%S\""
    if ((cmd | getline dt) >0) {
        printf "%-30s %15s %s\n", idx, cd, dt
    }
    close(cmd)
}
'
